FROM --platform=linux/arm64 python:3.9.10-slim

# 设置APT的环境变量
ENV TZ=Asia/Shanghai

# 更换debian源
COPY ./debian.sources /etc/apt/sources.list.d/debian.sources

# 安装系统依赖 + tzdata时区包
RUN apt-get clean && \
    apt-get update && \
    apt-get -y install tzdata cron vim libpq-dev gcc && \
    # 设置时区
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 先拷贝依赖文件，利用docker缓存
COPY ./requirements.txt /app/
# 安装python包，清理pip缓存（不要删/app！）
RUN pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --disable-pip-version-check \
    && rm -rf /root/.cache/pip

# 复制业务代码（放在pip install之后，代码变更不重复重装依赖）
COPY . /app

CMD ["python"]
